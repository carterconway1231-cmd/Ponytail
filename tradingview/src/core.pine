// ════════════════════════════════════════════════════════════════════
// ICT OTE core. Shared by the indicator and the strategy (see build.py)
//
// Model:
//   1. Swing highs/lows (pivots) define internal structure.
//   2. A close beyond a swing = break. MSS if it flips the trend, BOS if
//      it continues it.
//   3. The break's impulse leg (from its extreme back to the break) gets
//      an OTE zone at its 62-79% retracement.
//   4. When price trades back into the OTE and every enabled filter
//      passes, a signal fires. Stop beyond the leg's 100% point, target
//      at an extension of the leg (or an R multiple).
// Everything is evaluated on bar close; swings confirm `swingLen` bars
// late and HTF data uses the last closed HTF bar, so nothing repaints.
// ════════════════════════════════════════════════════════════════════

// ─── Inputs ─────────────────────────────────────────────────────────
const string G_STR  = "Market structure"
const string G_OTE  = "OTE setup"
const string G_FIL  = "Signal filters"
const string G_ZONE = "FVGs and order blocks"
const string G_LVL  = "Key levels"
const string G_VIS  = "Style"

swingLen   = input.int(5, "Swing length", minval = 2, maxval = 50, group = G_STR, tooltip = "Bars on each side that confirm a swing high/low. MSS/BOS, sweeps and the OTE leg all use these swings. Smaller = more and faster setups.")
mssOnly    = input.bool(false, "OTE after MSS only (skip BOS)", group = G_STR, tooltip = "On: only trend-flipping breaks (MSS) start an OTE setup. Off: continuation breaks (BOS) do too.")
showStruct = input.bool(true, "Show MSS / BOS", group = G_STR)
showSweeps = input.bool(true, "Show liquidity sweeps", group = G_STR)

fibLo   = input.float(0.62, "OTE from", minval = 0.0, maxval = 1.0, step = 0.01, group = G_OTE)
fibMid  = input.float(0.705, "Sweet spot", minval = 0.0, maxval = 1.0, step = 0.005, group = G_OTE)
fibHi   = input.float(0.79, "OTE to", minval = 0.0, maxval = 1.0, step = 0.01, group = G_OTE)
maxWait = input.int(40, "Setup expires after (bars)", minval = 5, group = G_OTE)
tpMode  = input.string("-0.27 extension", "Target", options = ["Leg extreme (0%)", "-0.27 extension", "-0.62 extension", "R multiple"], group = G_OTE)
tpR     = input.float(2.0, "R multiple", minval = 0.5, step = 0.25, group = G_OTE, tooltip = "Used when Target = R multiple.")
stopBuf = input.float(0.1, "Stop buffer (x ATR)", minval = 0.0, step = 0.05, group = G_OTE, tooltip = "The stop sits this far beyond the leg's 100% point.")
eodExit = input.bool(true, "Flat by 15:55 ET, no entries after", group = G_OTE)
showOte = input.bool(true, "Draw OTE zones", group = G_OTE)

useBias  = input.bool(true, "HTF bias", inline = "bias", group = G_FIL)
htfTf    = input.timeframe("60", "", inline = "bias", group = G_FIL)
htfLen   = input.int(50, "EMA", minval = 2, inline = "bias", group = G_FIL, tooltip = "Longs only when the last closed higher-timeframe bar is above its EMA, shorts only when below.")
useVol   = input.bool(true, "Volume spike in leg", inline = "vol", group = G_FIL)
volLen   = input.int(20, "Avg", minval = 2, inline = "vol", group = G_FIL)
volMult  = input.float(1.5, "x", minval = 1.0, step = 0.1, inline = "vol", group = G_FIL, tooltip = "At least one candle in the impulse leg must trade this multiple of its average volume. Ignored on symbols with no volume.")
usePD    = input.bool(true, "Longs in discount, shorts in premium", group = G_FIL)
drLen    = input.int(20, "Dealing range swing length", minval = 5, maxval = 100, group = G_FIL, tooltip = "Larger swings that define the dealing range used for premium/discount.")
useSweep = input.bool(false, "Require liquidity sweep before break", inline = "sw", group = G_FIL)
sweepLb  = input.int(30, "within", minval = 1, inline = "sw", group = G_FIL, tooltip = "Longs need a sell-side sweep, shorts a buy-side sweep, within this many bars before the break.")
useConfl = input.bool(false, "Require FVG or OB inside the OTE", group = G_FIL, tooltip = "Only zones that are switched on (and drawn) count.")

showFvg   = input.bool(true, "Fair value gaps", inline = "fvg", group = G_ZONE)
maxFvg    = input.int(8, "max", minval = 1, maxval = 50, inline = "fvg", group = G_ZONE)
fvgMin    = input.float(0.1, "Min FVG size (x ATR)", minval = 0.0, step = 0.05, group = G_ZONE)
showOb    = input.bool(true, "Order blocks", inline = "ob", group = G_ZONE)
maxOb     = input.int(6, "max", minval = 1, maxval = 50, inline = "ob", group = G_ZONE)
flipZones = input.bool(true, "Broken zones become IFVGs / breakers", group = G_ZONE, tooltip = "When a candle closes through an FVG or OB it flips: a broken bullish zone becomes bearish resistance and vice versa. A flipped zone that breaks again is removed.")

const string G_OBOS = "Overbought / oversold"
srsiLen  = input.int(14, "Stoch RSI: RSI", minval = 2, inline = "s1", group = G_OBOS)
stochLen = input.int(14, "Stoch", minval = 2, inline = "s1", group = G_OBOS)
kSmooth  = input.int(3, "K", minval = 1, inline = "s2", group = G_OBOS)
dSmooth  = input.int(3, "D", minval = 1, inline = "s2", group = G_OBOS)
srsiOB   = input.float(80, "OB", minval = 50, maxval = 100, inline = "s3", group = G_OBOS)
srsiOS   = input.float(20, "OS", minval = 0, maxval = 50, inline = "s3", group = G_OBOS)
showVwap = input.bool(true, "VWAP bands (σ)", inline = "vw", group = G_OBOS)
band1    = input.float(1.0, "", minval = 0.1, step = 0.25, inline = "vw", group = G_OBOS)
band2    = input.float(2.0, "", minval = 0.1, step = 0.25, inline = "vw", group = G_OBOS, tooltip = "Session VWAP (resets each NY day) with inner and outer standard-deviation bands. Beyond the outer band = stretched.")
scoreThr = input.int(60, "Exhaustion score threshold", minval = 10, maxval = 100, group = G_OBOS, tooltip = "The score blends Stoch RSI and distance from VWAP (in outer-band units) into −100 (oversold) … +100 (overbought).")
obosMode = input.string("Off", "Signal filter", options = ["Off", "Stoch RSI", "VWAP bands", "Score"], inline = "of", group = G_OBOS)
obosLb   = input.int(5, "within", minval = 0, inline = "of", group = G_OBOS, tooltip = "Longs need an oversold reading, shorts an overbought one, at some point in the last N bars. The chosen source also drives the exhaustion markers (the score when the filter is off).")
showExh  = input.bool(true, "Mark exhaustion on bars", group = G_OBOS)

const string G_TIME = "Killzones / Silver Bullet (NY time)"
kzLon    = input.session("0200-0500", "London", inline = "k1", group = G_TIME)
kzNyAm   = input.session("0930-1100", "NY AM", inline = "k1", group = G_TIME)
kzNyPm   = input.session("1330-1600", "NY PM", inline = "k2", group = G_TIME)
sbAm     = input.session("1000-1100", "SB AM", inline = "k3", group = G_TIME)
sbPm     = input.session("1400-1500", "SB PM", inline = "k3", group = G_TIME)
timeMode = input.string("Off", "Signal window", options = ["Off", "Killzones", "Silver Bullet"], group = G_TIME, tooltip = "Off: signals any time. Killzones: London / NY AM / NY PM only. Silver Bullet: the two one-hour windows only.")
showKz   = input.bool(true, "Shade killzones", inline = "sh", group = G_TIME)
showSb   = input.bool(true, "Shade Silver Bullet", inline = "sh", group = G_TIME)

const string G_GEX = "Gamma exposure (GEX)"
gexText = input.text_area("", "GEX levels", group = G_GEX, tooltip = "Paste the line printed by tradingview/gex.py, e.g.\nSPY cw=790 pw=760 flip=772.40 lv=780,775 net=+1.25B d=2026-10-13\nOne line per symbol; only the line for the chart's symbol is used.")
showGex = input.bool(true, "Draw GEX levels", group = G_GEX)
gexCap  = input.bool(false, "Cap targets at the call / put wall", group = G_GEX, tooltip = "Longs never target past the call wall, shorts never past the put wall (when the wall is between entry and target).")
gexCol  = input.color(#FF9800, "Walls", inline = "gc", group = G_GEX)
flipClr = input.color(#E040FB, "Flip", inline = "gc", group = G_GEX)

const string G_SQZ = "Volatility squeeze / momentum"
sqLen     = input.int(20, "Length", minval = 5, group = G_SQZ)
bbMult    = input.float(2.0, "Bollinger σ", minval = 0.5, step = 0.1, inline = "sq", group = G_SQZ)
kcMult    = input.float(1.5, "Keltner ATR", minval = 0.5, step = 0.1, inline = "sq", group = G_SQZ, tooltip = "Squeeze = Bollinger Bands inside the Keltner Channel (volatility compressed). Fired = the first bar they expand back out.")
showSq    = input.bool(true, "Mark squeeze and fire", group = G_SQZ)
colorBars = input.bool(false, "Color bars by momentum", group = G_SQZ, tooltip = "Bright = momentum accelerating, faded = momentum slowing.")
useAccel  = input.bool(false, "Require momentum turning in signal direction", group = G_SQZ, tooltip = "Longs need rising momentum (selling slowing or buying speeding up), shorts falling.")

showPD  = input.bool(true, "Premium / discount shading", group = G_LVL)
showPDL = input.bool(true, "Previous day high / low", group = G_LVL)
showPWL = input.bool(true, "Previous week high / low", group = G_LVL)
showDO  = input.bool(true, "Day open (first bar of the NY date)", group = G_LVL)
showRO  = input.bool(true, "9:30 open", group = G_LVL)

bullCol   = input.color(#089981, "Bull", inline = "c1", group = G_VIS)
bearCol   = input.color(#F23645, "Bear", inline = "c1", group = G_VIS)
oteCol    = input.color(#FFB300, "OTE", inline = "c1", group = G_VIS)
flipCol   = input.color(#9C27B0, "IFVG/BRK", inline = "c2", group = G_VIS)
lvlCol    = input.color(#787B86, "Levels", inline = "c2", group = G_VIS)
showTable = input.bool(true, "Dashboard", inline = "t", group = G_VIS)
tblPosIn  = input.string("Top right", "", options = ["Top right", "Bottom right", "Top left", "Bottom left"], inline = "t", group = G_VIS)

// ─── Types and helpers ──────────────────────────────────────────────
const string NY = "America/New_York"

type Zone
    box bx
    int dir   // 1 = bullish (support), -1 = bearish (resistance)
    int kind  // 0 = FVG, 1 = OB, 2 = IFVG, 3 = breaker

// Price at fib `f` of a leg running from `anchor` (100%) to `ext` (0%).
// Negative f gives extensions beyond the leg's extreme.
f_lvl(float anchor, float ext, float f) => ext + (anchor - ext) * f

f_zoneText(int kind, int dir) =>
    string name = kind == 0 ? "FVG" : kind == 1 ? "OB" : kind == 2 ? "IFVG" : "BRK"
    name + (dir == 1 ? " ▲" : " ▼")

f_zoneBase(int dir, int kind) => kind >= 2 ? flipCol : dir == 1 ? bullCol : bearCol

f_addZone(array<Zone> zs, int left, float zTop, float zBot, int dir, int kind, int maxN) =>
    color base = f_zoneBase(dir, kind)
    box bx = box.new(left, zTop, bar_index, zBot, border_color = color.new(base, 60), bgcolor = color.new(base, 85), text = f_zoneText(kind, dir), text_color = color.new(base, 20), text_size = size.tiny, text_halign = text.align_right)
    zs.push(Zone.new(bx, dir, kind))
    if zs.size() > maxN
        Zone old = zs.shift()
        old.bx.delete()

// Extend live zones; flip or delete the ones a close went through.
f_updateZones(array<Zone> zs, bool flip) =>
    int n = zs.size()
    if n > 0
        for i = n - 1 to 0
            Zone z = zs.get(i)
            float zTop = z.bx.get_top()
            float zBot = z.bx.get_bottom()
            bool broken = z.dir == 1 ? close < zBot : close > zTop
            if broken and flip and z.kind < 2
                z.dir  := -z.dir
                z.kind := z.kind + 2
                color base = f_zoneBase(z.dir, z.kind)
                z.bx.set_bgcolor(color.new(base, 85))
                z.bx.set_border_color(color.new(base, 60))
                z.bx.set_text_color(color.new(base, 20))
                z.bx.set_text(f_zoneText(z.kind, z.dir))
                z.bx.set_right(bar_index)
            else if broken
                z.bx.delete()
                zs.remove(i)
            else
                z.bx.set_right(bar_index)

// Does any zone pointing in `dir` overlap the price band [lo, hi]?
f_zoneIn(array<Zone> zs, int dir, float lo, float hi) =>
    bool found = false
    for z in zs
        if z.dir == dir and z.bx.get_top() >= lo and z.bx.get_bottom() <= hi
            found := true
    found

// ─── Series ─────────────────────────────────────────────────────────
atr      = ta.atr(14)
volAvg   = ta.sma(volume, volLen)
hasVol   = ta.cum(nz(volume)) > 0
volSpike = not na(volAvg) and volume > volAvg * volMult

// [1] + lookahead_on = the last *closed* HTF bar: no repainting.
[htfClose, htfEma] = request.security(syminfo.tickerid, htfTf, [close[1], ta.ema(close, htfLen)[1]], lookahead = barmerge.lookahead_on)
htfBias = na(htfClose) or na(htfEma) ? 0 : htfClose > htfEma ? 1 : htfClose < htfEma ? -1 : 0

pdh = request.security(syminfo.tickerid, "D", high[1], lookahead = barmerge.lookahead_on)
pdl = request.security(syminfo.tickerid, "D", low[1], lookahead = barmerge.lookahead_on)
pwh = request.security(syminfo.tickerid, "W", high[1], lookahead = barmerge.lookahead_on)
pwl = request.security(syminfo.tickerid, "W", low[1], lookahead = barmerge.lookahead_on)

nyDay      = dayofmonth(time, NY)
newDay     = nyDay != nyDay[1]
inRth      = not na(time(timeframe.period, "0930-1600", NY))
rthOpenBar = inRth and (not inRth[1] or newDay)
closeMin   = hour(time_close, NY) * 60 + minute(time_close, NY)
eodBar     = eodExit and timeframe.isintraday and closeMin >= 15 * 60 + 55

// Overbought / oversold
rsiV  = ta.rsi(close, srsiLen)
kLine = ta.sma(ta.stoch(rsiV, rsiV, rsiV, stochLen), kSmooth)
dLine = ta.sma(kLine, dSmooth)
[vwapV, vwUp, vwLo] = ta.vwap(hlc3, newDay, 1.0)
vwStd = vwUp - vwapV
vwZ   = vwStd > 0 ? (close - vwapV) / vwStd : 0.0
stochC    = na(kLine) ? 0.0 : (kLine - 50) / 50
vwapC     = math.max(-1.0, math.min(1.0, vwZ / band2))
obosScore = math.round(100 * (stochC + vwapC) / 2)
isOb = switch obosMode
    "Stoch RSI"  => kLine >= srsiOB
    "VWAP bands" => vwZ >= band2
    => obosScore >= scoreThr
isOs = switch obosMode
    "Stoch RSI"  => kLine <= srsiOS
    "VWAP bands" => vwZ <= -band2
    => obosScore <= -scoreThr
obRecent = ta.barssince(isOb) <= obosLb
osRecent = ta.barssince(isOs) <= obosLb

// Killzones / Silver Bullet
f_inSess(string sess) => timeframe.isintraday and not na(time(timeframe.period, sess, NY))
inLon  = f_inSess(kzLon)
inNyAm = f_inSess(kzNyAm)
inNyPm = f_inSess(kzNyPm)
inSb   = f_inSess(sbAm) or f_inSess(sbPm)
inKz   = inLon or inNyAm or inNyPm
timeOk = timeMode == "Off" or (timeMode == "Killzones" ? inKz : inSb)
// Volatility squeeze and momentum acceleration
sqBasis  = ta.sma(close, sqLen)
bbDev    = bbMult * ta.stdev(close, sqLen)
kcDev    = kcMult * ta.sma(ta.tr(true), sqLen)
sqOn     = bbDev < kcDev
sqFire   = sqOn[1] and not sqOn
sqAge    = ta.barssince(not sqOn)
bbExpand = bbDev > bbDev[1]
mom      = ta.linreg(close - math.avg(math.avg(ta.highest(high, sqLen), ta.lowest(low, sqLen)), sqBasis), sqLen, 0)
accel    = mom - mom[1]

// GEX levels from the pasted text (parsed once)
var float gexCw   = na
var float gexPw   = na
var float gexFlip = na
var float gexNet  = na
var string gexDate = ""
var array<float> gexLv = array.new<float>()
if barstate.isfirst and str.length(gexText) > 0
    for ln in str.split(gexText, "\n")
        array<string> toks = array.new<string>()
        for t in str.split(str.replace_all(ln, "\r", ""), " ")
            if str.length(t) > 0
                toks.push(t)
        if toks.size() > 1 and str.upper(toks.get(0)) == str.upper(syminfo.ticker)
            for tok in toks
                array<string> kv = str.split(tok, "=")
                if kv.size() == 2
                    string k = str.lower(kv.get(0))
                    string v = kv.get(1)
                    if k == "cw"
                        gexCw := str.tonumber(v)
                    else if k == "pw"
                        gexPw := str.tonumber(v)
                    else if k == "flip"
                        gexFlip := str.tonumber(v)
                    else if k == "net"
                        gexNet := str.tonumber(str.replace_all(str.replace_all(v, "B", ""), "+", ""))
                    else if k == "d"
                        gexDate := v
                    else if k == "lv"
                        for x in str.split(v, ",")
                            float lvV = str.tonumber(x)
                            if not na(lvV)
                                gexLv.push(lvV)
hasGex  = not na(gexCw) or not na(gexPw) or not na(gexFlip)
gRegime = not na(gexFlip) ? (close >= gexFlip ? 1 : -1) : not na(gexNet) ? (gexNet >= 0 ? 1 : -1) : 0

sessName = (inLon ? "London" : inNyAm ? "NY AM" : inNyPm ? "NY PM" : "Outside KZ") + (inSb ? " · SB" : "")

var float dayOpen = na
var float rthOpen = na
if newDay
    dayOpen := open
    rthOpen := na
if rthOpenBar
    rthOpen := open

// ─── Swings, sweeps and breaks ──────────────────────────────────────
ph = ta.pivothigh(high, swingLen, swingLen)
pl = ta.pivotlow(low, swingLen, swingLen)

var float shPrice = na
var int   shIdx   = na
var bool  shLive  = false  // not yet closed through
var bool  shSwept = false  // already wicked through once
var float slPrice = na
var int   slIdx   = na
var bool  slLive  = false
var bool  slSwept = false
var int   trend   = 0      // 1 = last break bullish, -1 = bearish
var bool  lastMss = false
var int   lastBsl = na     // bar of the last buy-side sweep
var int   lastSsl = na     // bar of the last sell-side sweep

if not na(ph)
    shPrice := ph
    shIdx   := bar_index - swingLen
    shLive  := true
    shSwept := false
if not na(pl)
    slPrice := pl
    slIdx   := bar_index - swingLen
    slLive  := true
    slSwept := false

// Dealing range for premium/discount: the latest major swings, widened
// whenever price trades beyond them.
mph = ta.pivothigh(high, drLen, drLen)
mpl = ta.pivotlow(low, drLen, drLen)
var float drHigh  = na
var float drLow   = na
var int   drHiIdx = na
var int   drLoIdx = na
if not na(mph)
    drHigh  := mph
    drHiIdx := bar_index - drLen
if not na(mpl)
    drLow   := mpl
    drLoIdx := bar_index - drLen
if not na(drHigh) and high > drHigh
    drHigh := high
if not na(drLow) and low < drLow
    drLow := low
drEq  = (drHigh + drLow) / 2
drPct = drHigh > drLow ? (close - drLow) / (drHigh - drLow) : na

// Sweep: wick through a live swing, close back inside.
bslSweep = shLive and not shSwept and high > shPrice and close <= shPrice
sslSweep = slLive and not slSwept and low < slPrice and close >= slPrice
if bslSweep
    shSwept := true
    lastBsl := bar_index
    if showSweeps
        line.new(shIdx, shPrice, bar_index, shPrice, color = color.new(bearCol, 40), style = line.style_dotted)
        label.new(bar_index, shPrice, "BSL ✕", yloc = yloc.abovebar, color = color.new(bearCol, 100), textcolor = bearCol, style = label.style_none, size = size.small)
if sslSweep
    slSwept := true
    lastSsl := bar_index
    if showSweeps
        line.new(slIdx, slPrice, bar_index, slPrice, color = color.new(bullCol, 40), style = line.style_dotted)
        label.new(bar_index, slPrice, "SSL ✕", yloc = yloc.belowbar, color = color.new(bullCol, 100), textcolor = bullCol, style = label.style_none, size = size.small)

bullBreak = shLive and close > shPrice
bearBreak = slLive and close < slPrice and not bullBreak
brkDir    = bullBreak ? 1 : bearBreak ? -1 : 0
isMssNow  = brkDir != 0 and trend != brkDir

// ─── FVGs / order blocks ────────────────────────────────────────────
var array<Zone> fvgZones = array.new<Zone>()
var array<Zone> obZones  = array.new<Zone>()
f_updateZones(fvgZones, flipZones)
f_updateZones(obZones, flipZones)

bullFvg = low > high[2] and low - high[2] >= atr * fvgMin
bearFvg = high < low[2] and low[2] - high >= atr * fvgMin
if showFvg and bullFvg
    f_addZone(fvgZones, bar_index - 1, low, high[2], 1, 0, maxFvg)
if showFvg and bearFvg
    f_addZone(fvgZones, bar_index - 1, low[2], high, -1, 0, maxFvg)

// ─── Open trade: stop / target / end of day ─────────────────────────
// One trade at a time. Entry is this bar's close; a stop and target hit
// on the same bar counts as the stop (conservative).
var int   posDir    = 0
var float posEntry  = na
var float posStop   = na
var float posTarget = na
var int   posBar    = na
var int   wins      = 0
var int   losses    = 0
var float totalR    = 0.0

exitNow = false
exitR   = 0.0
if posDir != 0 and bar_index > posBar
    float risk = math.abs(posEntry - posStop)
    bool hitStop = posDir == 1 ? low <= posStop : high >= posStop
    bool hitTgt  = posDir == 1 ? high >= posTarget : low <= posTarget
    if hitStop
        exitR   := -1.0
        exitNow := true
    else if hitTgt
        exitR   := math.abs(posTarget - posEntry) / risk
        exitNow := true
    else if eodBar
        exitR   := posDir * (close - posEntry) / risk
        exitNow := true
    if exitNow
        wins   += exitR > 0 ? 1 : 0
        losses += exitR > 0 ? 0 : 1
        totalR += exitR
        posDir := 0

// ─── Pending OTE setup → signal ─────────────────────────────────────
var int   sDir    = 0     // 1 = long setup, -1 = short, 0 = none
var float sAnchor = na    // leg's 100% (start of the impulse)
var float sExt    = na    // leg's 0% (impulse extreme)
var int   sBar    = na
var bool  sVol    = false
var bool  sSweep  = false
var box   sBox    = na
var line  sLine   = na
var array<box>  oteBoxes = array.new<box>()
var array<line> oteLines = array.new<line>()

longSig   = false
shortSig  = false
sigEntry  = float(na)
sigStop   = float(na)
sigTarget = float(na)

if sDir != 0 and bar_index > sBar
    bool invalid = sDir == 1 ? low < sAnchor : high > sAnchor
    bool expired = bar_index - sBar > maxWait
    if invalid or expired
        if showOte
            sBox.set_bgcolor(color.new(lvlCol, 90))
            sBox.set_border_color(color.new(lvlCol, 70))
            sBox.set_text_color(lvlCol)
        sDir := 0
    else
        // The leg keeps extending until price pulls back into the OTE.
        if sDir == 1 and high > sExt
            sExt := high
        if sDir == -1 and low < sExt
            sExt := low
        float l1 = f_lvl(sAnchor, sExt, fibLo)
        float l2 = f_lvl(sAnchor, sExt, fibHi)
        float lm = f_lvl(sAnchor, sExt, fibMid)
        float zLo = math.min(l1, l2)
        float zHi = math.max(l1, l2)
        if showOte
            sBox.set_top(zHi)
            sBox.set_bottom(zLo)
            sBox.set_right(bar_index)
            sLine.set_y1(lm)
            sLine.set_xy2(bar_index, lm)
        bool touched = sDir == 1 ? low <= l1 : high >= l1
        bool biasOk  = not useBias or htfBias == sDir
        bool volOk   = not useVol or sVol
        bool pdOk    = not usePD or na(drEq) or (sDir == 1 ? close < drEq : close > drEq)
        bool sweepOk = not useSweep or sSweep
        bool conflOk = not useConfl or f_zoneIn(fvgZones, sDir, zLo, zHi) or f_zoneIn(obZones, sDir, zLo, zHi)
        bool obosOk  = obosMode == "Off" or (sDir == 1 ? osRecent : obRecent)
        bool accelOk = not useAccel or sDir * accel > 0
        if touched and biasOk and volOk and pdOk and sweepOk and conflOk and obosOk and accelOk and timeOk and posDir == 0 and not exitNow and not eodBar
            float entry = close
            float stop  = sAnchor - sDir * atr * stopBuf
            float risk  = math.abs(entry - stop)
            float tgt = switch tpMode
                "Leg extreme (0%)" => sExt
                "-0.27 extension"  => f_lvl(sAnchor, sExt, -0.27)
                "-0.62 extension"  => f_lvl(sAnchor, sExt, -0.62)
                => entry + sDir * risk * tpR
            float wall = sDir == 1 ? gexCw : gexPw
            if gexCap and not na(wall) and sDir * (wall - entry) > 0 and sDir * (tgt - wall) > 0
                tgt := wall
            if risk > 0 and sDir * (tgt - entry) > 0
                longSig   := sDir == 1
                shortSig  := sDir == -1
                sigEntry  := entry
                sigStop   := stop
                sigTarget := tgt
                posDir    := sDir
                posEntry  := entry
                posStop   := stop
                posTarget := tgt
                posBar    := bar_index
                if showOte
                    sBox.set_bgcolor(color.new(sDir == 1 ? bullCol : bearCol, 80))
                sDir := 0

// ─── Structure break → new OTE setup ────────────────────────────────
if brkDir != 0
    int   refIdx   = brkDir == 1 ? shIdx : slIdx
    float refPrice = brkDir == 1 ? shPrice : slPrice
    if brkDir == 1
        shLive := false
    else
        slLive := false

    // Leg anchor: the lowest low (longs) / highest high (shorts) since the
    // broken swing formed.
    int   n         = math.min(bar_index - refIdx, 300)
    float anchorV   = brkDir == 1 ? low : high
    int   anchorOff = 0
    for i = 0 to n
        float p = brkDir == 1 ? low[i] : high[i]
        if brkDir * (p - anchorV) < 0
            anchorV   := p
            anchorOff := i
    float extV   = brkDir == 1 ? high : low
    bool  legVol = false
    for i = 0 to anchorOff
        float q = brkDir == 1 ? high[i] : low[i]
        if brkDir * (q - extV) > 0
            extV := q
        if volSpike[i]
            legVol := true

    color c = brkDir == 1 ? bullCol : bearCol
    if showStruct
        line.new(refIdx, refPrice, bar_index, refPrice, color = c, style = isMssNow ? line.style_solid : line.style_dashed)
        label.new(math.round((refIdx + bar_index) / 2), refPrice, isMssNow ? "MSS" : "BOS", color = color.new(c, 100), textcolor = c, style = brkDir == 1 ? label.style_label_down : label.style_label_up, size = size.small)

    // Order block: the last opposite-colored candle at the start of the leg.
    if showOb
        int lim = math.min(anchorOff + 5, bar_index)
        for j = anchorOff to lim
            if brkDir * (close[j] - open[j]) < 0
                f_addZone(obZones, bar_index - j, high[j], low[j], brkDir, 1, maxOb)
                break

    if not mssOnly or isMssNow
        if sDir != 0 and showOte
            sBox.set_bgcolor(color.new(lvlCol, 90))
            sBox.set_border_color(color.new(lvlCol, 70))
            sBox.set_text_color(lvlCol)
        int lastSw = brkDir == 1 ? lastSsl : lastBsl
        sDir    := brkDir
        sAnchor := anchorV
        sExt    := extV
        sBar    := bar_index
        sVol    := legVol or not hasVol
        sSweep  := not na(lastSw) and bar_index - lastSw <= sweepLb
        if showOte
            float o1 = f_lvl(anchorV, extV, fibLo)
            float o2 = f_lvl(anchorV, extV, fibHi)
            float om = f_lvl(anchorV, extV, fibMid)
            sBox  := box.new(bar_index, math.max(o1, o2), bar_index, math.min(o1, o2), border_color = color.new(oteCol, 50), bgcolor = color.new(oteCol, 85), text = "OTE", text_color = oteCol, text_size = size.tiny, text_halign = text.align_left)
            sLine := line.new(bar_index, om, bar_index, om, color = oteCol, style = line.style_dotted)
            oteBoxes.push(sBox)
            oteLines.push(sLine)
            if oteBoxes.size() > 30
                oteBoxes.shift().delete()
                oteLines.shift().delete()
    trend   := brkDir
    lastMss := isMssNow

// ─── Premium / discount and key levels ──────────────────────────────
var box  pBox = na
var box  dBox = na
var line eqLn = na
if showPD and barstate.islast and drHigh > drLow
    int left = math.min(drHiIdx, drLoIdx)
    box.delete(pBox)
    box.delete(dBox)
    line.delete(eqLn)
    pBox := box.new(left, drHigh, bar_index + 10, drEq, border_width = 0, bgcolor = color.new(bearCol, 93), text = "Premium", text_color = color.new(bearCol, 50), text_size = size.small, text_halign = text.align_right, text_valign = text.align_top)
    dBox := box.new(left, drEq, bar_index + 10, drLow, border_width = 0, bgcolor = color.new(bullCol, 93), text = "Discount", text_color = color.new(bullCol, 50), text_size = size.small, text_halign = text.align_right, text_valign = text.align_bottom)
    eqLn := line.new(left, drEq, bar_index + 10, drEq, color = color.new(lvlCol, 30), style = line.style_dashed)

// na on the bar a level changes, so plot.style_linebr draws a clean step.
f_brk(float v) => ta.change(v) != 0 ? float(na) : v
pdhP = f_brk(pdh)
pdlP = f_brk(pdl)
pwhP = f_brk(pwh)
pwlP = f_brk(pwl)
doP  = newDay ? float(na) : dayOpen
roP  = rthOpenBar ? float(na) : rthOpen

plot(showPDL ? pdhP : na, "PDH", color.new(lvlCol, 20), 1, plot.style_linebr)
plot(showPDL ? pdlP : na, "PDL", color.new(lvlCol, 20), 1, plot.style_linebr)
plot(showPWL ? pwhP : na, "PWH", color.new(lvlCol, 0), 2, plot.style_linebr)
plot(showPWL ? pwlP : na, "PWL", color.new(lvlCol, 0), 2, plot.style_linebr)
plot(showDO ? doP : na, "Day open", color.new(oteCol, 40), 1, plot.style_linebr)
plot(showRO ? roP : na, "9:30 open", color.new(#2962FF, 30), 1, plot.style_linebr)

// VWAP and bands (broken at each NY day so sessions don't join up)
vwP = newDay ? float(na) : vwapV
plot(showVwap ? vwP : na, "VWAP", color.new(#00BCD4, 0), 2, plot.style_linebr)
plot(showVwap ? vwP + band1 * vwStd : na, "VWAP +1σ", color.new(lvlCol, 50), 1, plot.style_linebr)
plot(showVwap ? vwP - band1 * vwStd : na, "VWAP −1σ", color.new(lvlCol, 50), 1, plot.style_linebr)
plot(showVwap ? vwP + band2 * vwStd : na, "VWAP +2σ", color.new(bearCol, 40), 1, plot.style_linebr)
plot(showVwap ? vwP - band2 * vwStd : na, "VWAP −2σ", color.new(bullCol, 40), 1, plot.style_linebr)

// Exhaustion: first bar of each overbought / oversold run
plotshape(showExh and isOb and not isOb[1], "Overbought", shape.circle, location.abovebar, color.new(bearCol, 30), size = size.tiny)
plotshape(showExh and isOs and not isOs[1], "Oversold", shape.circle, location.belowbar, color.new(bullCol, 30), size = size.tiny)

// Session shading
bgcolor(showKz and inLon ? color.new(#2962FF, 93) : showKz and (inNyAm or inNyPm) ? color.new(oteCol, 94) : na, title = "Killzones")
bgcolor(showSb and inSb ? color.new(flipCol, 91) : na, title = "Silver Bullet")

// Squeeze / momentum
plotshape(showSq and sqOn, "Squeeze on", shape.diamond, location.bottom, color.new(lvlCol, 20), size = size.tiny)
plotshape(showSq and sqFire and mom >= 0, "Squeeze fired up", shape.triangleup, location.bottom, bullCol, size = size.small, text = "FIRE", textcolor = bullCol)
plotshape(showSq and sqFire and mom < 0, "Squeeze fired down", shape.triangledown, location.bottom, bearCol, size = size.small, text = "FIRE", textcolor = bearCol)
barcolor(colorBars ? (mom >= 0 ? (accel > 0 ? bullCol : color.new(bullCol, 55)) : (accel < 0 ? bearCol : color.new(bearCol, 55))) : na, title = "Momentum bars")

// GEX levels: drawn from the start of the current day
var int dayStartBar = na
if newDay
    dayStartBar := bar_index
var array<line>  gexLines = array.new<line>()
var array<label> gexTags  = array.new<label>()
f_gexLine(float y, string txt, color c, int w, string st) =>
    if not na(y)
        gexLines.push(line.new(nz(dayStartBar, bar_index), y, bar_index + 15, y, color = c, width = w, style = st))
        gexTags.push(label.new(bar_index + 15, y, txt + " " + str.tostring(y), color = color.new(c, 100), textcolor = c, style = label.style_label_left, size = size.small))
if barstate.islast and showGex and hasGex
    for ln in gexLines
        ln.delete()
    for lb in gexTags
        lb.delete()
    gexLines.clear()
    gexTags.clear()
    f_gexLine(gexCw, "Call wall", gexCol, 2, line.style_solid)
    f_gexLine(gexPw, "Put wall", gexCol, 2, line.style_solid)
    f_gexLine(gexFlip, "γ flip", flipClr, 2, line.style_dashed)
    for lvV in gexLv
        f_gexLine(lvV, "γ", color.new(gexCol, 40), 1, line.style_dotted)

f_tag(array<label> arr, bool show, float y, string txt) =>
    if show and not na(y)
        arr.push(label.new(bar_index + 2, y, txt, color = color.new(lvlCol, 100), textcolor = lvlCol, style = label.style_label_left, size = size.small))

var array<label> lvlTags = array.new<label>()
if barstate.islast
    for lb in lvlTags
        lb.delete()
    lvlTags.clear()
    f_tag(lvlTags, showPDL, pdh, "PDH")
    f_tag(lvlTags, showPDL, pdl, "PDL")
    f_tag(lvlTags, showPWL, pwh, "PWH")
    f_tag(lvlTags, showPWL, pwl, "PWL")
    f_tag(lvlTags, showDO, dayOpen, "Day open")
    f_tag(lvlTags, showRO, rthOpen, "9:30 open")

// ─── Dashboard / alerts (filled in by the indicator or strategy) ────
tblPos = switch tblPosIn
    "Top right"    => position.top_right
    "Bottom right" => position.bottom_right
    "Top left"     => position.top_left
    => position.bottom_left
var table dash = table.new(tblPos, 2, 13, bgcolor = color.new(#131722, 10), border_color = color.new(lvlCol, 70), border_width = 1, frame_color = color.new(lvlCol, 50), frame_width = 1)

f_cell(int row, string k, string v, color vc) =>
    table.cell(dash, 0, row, k, text_color = color.new(color.white, 30), text_size = size.small, text_halign = text.align_left)
    table.cell(dash, 1, row, v, text_color = vc, text_size = size.small, text_halign = text.align_right)

f_drawTable(string statsKey, string statsVal) =>
    if showTable and barstate.islast
        f_cell(0, "ICT OTE", syminfo.ticker + " · " + timeframe.period, color.white)
        string biasTxt = not useBias ? "Off" : htfBias == 1 ? "Bullish" : htfBias == -1 ? "Bearish" : "Neutral"
        f_cell(1, "HTF bias (" + htfTf + ")", biasTxt, htfBias == 1 ? bullCol : htfBias == -1 ? bearCol : lvlCol)
        string structTxt = trend == 0 ? "–" : (trend == 1 ? "Bullish" : "Bearish") + (lastMss ? " (MSS)" : " (BOS)")
        f_cell(2, "Structure", structTxt, trend == 1 ? bullCol : trend == -1 ? bearCol : lvlCol)
        string pdTxt = na(drPct) ? "–" : (drPct > 0.5 ? "Premium " : "Discount ") + str.tostring(math.round(drPct * 100)) + "%"
        f_cell(3, "Dealing range", pdTxt, na(drPct) ? lvlCol : drPct > 0.5 ? bearCol : bullCol)
        string obosTxt = (isOb ? "Overbought " : isOs ? "Oversold " : "Neutral ") + str.tostring(obosScore) + " · K " + (na(kLine) ? "–" : str.tostring(math.round(kLine)))
        f_cell(4, "OB/OS (" + (obosMode == "Off" ? "Score" : obosMode) + ")", obosTxt, isOb ? bearCol : isOs ? bullCol : lvlCol)
        f_cell(5, "Session", timeframe.isintraday ? sessName : "–", inSb ? flipCol : inKz ? oteCol : lvlCol)
        string gTxt = not hasGex ? "No GEX data" : (gRegime == 1 ? "Positive · pin / revert" : "Negative · trend / expand") + (gexDate == "" ? "" : " (" + gexDate + ")")
        f_cell(6, "Gamma", gTxt, gRegime == 1 ? bullCol : gRegime == -1 ? bearCol : lvlCol)
        string vTxt = sqOn ? "Squeeze · " + str.tostring(sqAge) + " bars" : sqFire ? "Squeeze fired" : bbExpand ? "Expanding" : "Contracting"
        f_cell(7, "Volatility", vTxt, sqOn ? oteCol : sqFire ? color.white : lvlCol)
        string mTxt = mom >= 0 ? (accel > 0 ? "Bull · accelerating" : "Bull · fading") : (accel < 0 ? "Bear · accelerating" : "Bear · fading")
        f_cell(8, "Momentum", na(mom) ? "–" : mTxt, mom >= 0 ? bullCol : bearCol)
        string setupTxt = sDir == 0 ? "None" : (sDir == 1 ? "Long" : "Short") + ", waiting for OTE"
        f_cell(9, "Setup", setupTxt, sDir == 0 ? lvlCol : oteCol)
        string volTxt = sDir == 0 ? "–" : sVol ? "Spike ✓" : "No spike"
        f_cell(10, "Leg volume", volTxt, sDir == 0 ? lvlCol : sVol ? bullCol : bearCol)
        string posTxt = posDir == 0 ? "Flat" : (posDir == 1 ? "Long @ " : "Short @ ") + str.tostring(posEntry, format.mintick)
        f_cell(11, "Position", posTxt, posDir == 1 ? bullCol : posDir == -1 ? bearCol : lvlCol)
        f_cell(12, statsKey, statsVal, color.white)

f_alertMsg() =>
    (longSig ? "ICT OTE LONG " : "ICT OTE SHORT ") + syminfo.ticker + " (" + timeframe.period + ")" + " entry " + str.tostring(sigEntry, format.mintick) + " stop " + str.tostring(sigStop, format.mintick) + " target " + str.tostring(sigTarget, format.mintick)
