# --- Ponytail options agent (python -m ponytail) ---------------------------
# Your agent-enabled Robinhood account (the "Agentic" account).
ROBINHOOD_ACCOUNT_NUMBER=
SYMBOLS=SPY,QQQ,AAPL,MSFT,NVDA

# false = paper trading: orders are intercepted and simulated at the limit price.
# Only flip to true after the account has options approval and funds.
LIVE_TRADING=false

# Hard risk limits (enforced in code; dollars of premium, 1 contract = price x 100)
MAX_PREMIUM_PER_TRADE=200
MAX_TOTAL_PREMIUM=600
MAX_OPEN_POSITIONS=3
MAX_DAILY_LOSS=150          # realized today + open losses; halts new entries
MAX_WEEKLY_LOSS=300         # realized, trailing 7 days; halts new entries
MAX_CONSECUTIVE_LOSSES=3    # this many losers in a row -> no new entries until tomorrow
LOSS_COOLDOWN_DAYS=3        # no re-entry in a symbol for N days after a losing exit

# Contract filters
MIN_DTE=14
MAX_DTE=60
MIN_ABS_DELTA=0.30
MAX_ABS_DELTA=0.70
MAX_SPREAD_PCT=0.10
MIN_OPEN_INTEREST=100
MAX_QUOTE_AGE_MIN=30
AVOID_EARNINGS=true

# Exits and stop losses
TAKE_PROFIT_PCT=0.50
STOP_LOSS_PCT=0.35          # resting stop order at entry * (1 - this)
TRAIL_ACTIVATE_PCT=0.30     # once up 30%, the stop starts trailing...
TRAIL_PCT=0.25              # ...25% below the highest mark seen (only ever moves up)
STOP_ORDER_TYPE=stop_market # stop_market: guaranteed exit, day-only (re-placed each morning)
                            # stop_limit: GTC (protects overnight) but can miss a gap
STOP_LIMIT_BUFFER_PCT=0.15  # stop_limit only: limit price this far below the trigger
EXIT_DTE=7

# Signal engine & learning
SIGNAL_THRESHOLD=0.25        # |learned-weight score| needed for BUY/SELL
MIN_CONFLUENCE=4             # factors that must agree (and outnumber opposers 2:1)
MIN_WIN_PROB=0.52            # learned win-rate floor, enforced once a conviction level has history
MIN_CALIBRATION_TRADES=10    # trades at a conviction level before the win-rate/EV gates apply
LEARN_DECAY=0.97             # forgetting per update: lower = adapts faster, noisier
SHADOW_WEIGHT=0.3            # how much an untraded signal's outcome teaches vs a real trade
SHADOW_HORIZON=5             # trading days before an untraded signal is graded

# Agent runtime (per-run spend cap on Claude usage)
AGENT_MODEL=claude-opus-5-5
AGENT_EFFORT=high
AGENT_MAX_TURNS=80
AGENT_MAX_BUDGET_USD=3.0
AGENT_STATE_PATH=agent_state.json

# Optional: connect to Robinhood's MCP server with a bearer token instead of
# the OAuth login registered via `claude mcp add` (see README).
# ROBINHOOD_MCP_URL=https://agent.robinhood.com/mcp/trading
# ROBINHOOD_MCP_TOKEN=

# --- Legacy equity bot (robinhood_trading_bot.py, robin_stocks) ------------
ROBINHOOD_USERNAME=you@example.com
ROBINHOOD_PASSWORD=your-password
TRADE_AMOUNT=100
