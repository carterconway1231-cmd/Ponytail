# --- Ponytail options agent (python -m ponytail) ---------------------------
# Your agent-enabled Robinhood account (the "Agentic" account).
ROBINHOOD_ACCOUNT_NUMBER=
SYMBOLS=SPY,QQQ,AAPL,MSFT,NVDA

# false = paper trading: orders are intercepted and simulated at the limit price.
# Only flip to true after the account has options approval and funds.
LIVE_TRADING=false

# Hard risk limits (enforced in code; dollars of premium, 1 contract = price x 100)
MAX_PREMIUM_PER_TRADE=200
MAX_TOTAL_PREMIUM=600
MAX_OPEN_POSITIONS=3
MAX_DAILY_LOSS=150          # realized today + open losses; halts new entries
MAX_WEEKLY_LOSS=300         # realized, trailing 7 days; halts new entries
MAX_CONSECUTIVE_LOSSES=3    # this many losers in a row -> no new entries until tomorrow
LOSS_COOLDOWN_DAYS=3        # no re-entry in a symbol for N days after a losing exit

# Contract filters
MIN_DTE=14
MAX_DTE=60
MIN_ABS_DELTA=0.30
MAX_ABS_DELTA=0.70
MAX_SPREAD_PCT=0.10
MIN_OPEN_INTEREST=100
MAX_QUOTE_AGE_MIN=30
AVOID_EARNINGS=true

# Exits and stop losses
TAKE_PROFIT_PCT=0.50
STOP_LOSS_PCT=0.35          # resting stop at entry * (1 - this); tuned from results if ADAPTIVE_EXITS
TRAIL_ACTIVATE_PCT=0.30     # once up 30%, the stop starts trailing...
TRAIL_PCT=0.25              # ...25% below the highest mark seen (only ever moves up)
STOP_ORDER_TYPE=stop_market # stop_market: guaranteed exit, day-only (re-placed each morning)
                            # stop_limit: GTC (protects overnight) but can miss a gap
STOP_LIMIT_BUFFER_PCT=0.15  # stop_limit only: limit price this far below the trigger
EXIT_DTE=7

# Signal engine & learning
SIGNAL_THRESHOLD=0.25        # |learned-weight score| needed for BUY/SELL
MIN_CONFLUENCE=4             # factors that must agree (and outnumber opposers 2:1)
MIN_WIN_PROB=0.52            # learned win-rate floor, enforced once a conviction level has history
MIN_CALIBRATION_TRADES=10    # trades at a conviction level before the win-rate/EV gates apply
LEARN_HALF_LIFE_DAYS=90      # evidence half-life: shorter = adapts faster, noisier
WARM_START_WEIGHT=0.3        # how much one replayed historical day teaches vs a real trade
SHADOW_WEIGHT=0.3            # how much an untraded signal's outcome teaches vs a real trade
SHADOW_HORIZON=5             # trading days before an untraded signal is graded

# Agent runtime (per-run spend cap on Claude usage)
AGENT_MODEL=claude-opus-5-5
AGENT_EFFORT=high
AGENT_MAX_TURNS=80
AGENT_MAX_BUDGET_USD=3.0
AGENT_STATE_PATH=agent_state.json

# Optional: connect to Robinhood's MCP server with a bearer token instead of
# the OAuth login registered via `claude mcp add` (see README).
# ROBINHOOD_MCP_URL=https://agent.robinhood.com/mcp/trading
# ROBINHOOD_MCP_TOKEN=

# Strategy: premium = sell SPY/QQQ put credit spreads when IV > realized vol
# (the default; see README "Premium strategy"); directional = the factor engine.
STRATEGY=premium
PREMIUM_SIDE=put              # put | call | both
PREMIUM_SHORT_DELTA=0.20
PREMIUM_MAX_SHORT_DELTA=0.35
PREMIUM_MIN_DTE=30
PREMIUM_MAX_DTE=60
PREMIUM_TAKE_PROFIT=0.50      # close after capturing 50% of the credit
PREMIUM_STOP_X=2.0            # close when the loss reaches 2x the credit
PREMIUM_MANAGE_DTE=21         # close at 21 DTE regardless
PREMIUM_MIN_IV_RV=1.0         # ATM IV must be >= realized vol x this
PREMIUM_MIN_CREDIT_PCT=0.10   # credit >= 10% of the spread width
PREMIUM_RISK_PCT=0.10         # max loss per position, fraction of equity
PREMIUM_MAX_TOTAL_RISK_PCT=0.40
PREMIUM_MAX_WIDTH_PCT=0.01    # spread width <= 1% of spot
PREMIUM_ALLOW_STOCKS=false    # single-stock spreads lost to bid/ask in the backtest

# Volatility & structure (debit spreads need options level 3)
ALLOW_SPREADS=true
IV_RANK_EXPENSIVE=60
IV_RANK_CHEAP=30
IV_RV_EXPENSIVE=1.4          # IV / realized vol above this = expensive (used until IV rank has 20 days)
MAX_SPREAD_DEBIT_PCT=0.60    # spread debit must be <= this fraction of the strike width

# Contract selection by expected value
MIN_CONTRACT_EV=0.0          # EV per $ of premium must be >= this (negative = allow modeled losers)
EV_HOLD_DAYS=5
ENTRY_SLIPPAGE_PCT=0.25      # expected fill: mid + this fraction of the half-spread

# Position sizing
PAPER_CAPITAL=3000           # paper equity baseline: set to what you plan to fund
BASE_RISK_PCT=0.03           # risk per trade before the learner has calibrated edge
KELLY_FRACTION=0.25
MAX_RISK_PCT=0.06
STOP_GAP_ALLOWANCE=1.3

# Exit learning
TIME_STOP_DAYS=10
TIME_STOP_MIN_GAIN=0.10
ADAPTIVE_EXITS=true
MIN_EXIT_SAMPLES=15

# Universe, events, execution
DISCOVER=true                # add scanner names with unusual options activity
MAX_DISCOVERED=5
EVENTS_PATH=events.json      # FOMC/CPI dates; keep CPI dates current
EVENT_BLACKOUT_DAYS=1
ENTRY_WINDOW=09:45-15:45     # US/Eastern

# Go-live gate (LIVE_TRADING only honored after paper results pass)
MIN_PAPER_TRADES=30
MIN_PAPER_DAYS=20
MIN_PROFIT_FACTOR=1.2
MAX_DRAWDOWN_PCT=0.25
FORCE_LIVE=false

# Cost control & alerts
MONITOR_MODEL=claude-haiku-5-5
MONITOR_EFFORT=low
MONITOR_BUDGET_USD=0.30
ALERT_WEBHOOK_URL=           # Slack/Discord incoming webhook or https://ntfy.sh/<topic>

# --- Legacy equity bot (robinhood_trading_bot.py, robin_stocks) ------------
ROBINHOOD_USERNAME=you@example.com
ROBINHOOD_PASSWORD=your-password
TRADE_AMOUNT=100
